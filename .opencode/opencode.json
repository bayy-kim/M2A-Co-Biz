{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["./plugins/graphify.mjs"],
  "instructions": ["AGENTS.md", "PRD.md", "SAR.md", "DESIGN.md"],
  "compaction": {
    "auto": true,
    "tail_turns": 2
  },
  "agent": {
    "build": {
      "mode": "primary",
      "permission": { "edit": "allow", "bash": "allow" }
    },
    "plan": {
      "mode": "primary",
      "permission": { "edit": "deny", "bash": "deny" }
    }
  }
}
